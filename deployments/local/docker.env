APP_ENV=docker

# --- MongoDB: 1 database = 1 bounded context (PGTOMONGODB.md §1.1) ---
# HOST menunjuk ke service compose mongo; PORT adalah port mongod DI DALAM
# network compose (semua instance listen di 27017, dibedakan oleh nama host).
# MONGO_HOST / MONGO_PORT / MONGO_DB base sengaja TIDAK didefinisikan supaya key
# per-context yang lupa diisi bikin service gagal start, bukan diam-diam
# nyambung ke DB context lain.
MONGO_IDENTITY_HOST=mongo_identity
MONGO_IDENTITY_PORT=27017
MONGO_IDENTITY_DB=pg_identity

MONGO_PAYMENT_HOST=mongo_payment
MONGO_PAYMENT_PORT=27017
MONGO_PAYMENT_DB=pg_payment

MONGO_FINANCIAL_HOST=mongo_financial
MONGO_FINANCIAL_PORT=27017
MONGO_FINANCIAL_DB=pg_financial

SECRET_KEY=yantopedia

# Redis Cluster Addrs (6 nodes)
REDIS_ADDRS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379
REDIS_PASSWORD=dragon_knight
REDIS_DB=0

# Redis 1 Cluster Addrs (for apigateway)
REDIS_1_ADDRS=redis-node-1:6379,redis-node-2:6379,redis-node-3:6379,redis-node-4:6379,redis-node-5:6379,redis-node-6:6379
REDIS_1_PASSWORD=dragon_knight
REDIS_1_DB=0

# ClickHouse Cluster Config
CLICKHOUSE_ADDR=clickhouse:9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=dragon
CLICKHOUSE_PASSWORD=dragon_knight

KAFKA_BROKERS=kafka-1:9092

APP_LOGGER=production

# Card statement generation day (1-31)
BILLING_CYCLE_DAY=1

# Daily withdrawal limit per card
WITHDRAW_DAILY_LIMIT=10000000

OTEL_ENDPOINT=otel-collector:4317

GRPC_AUTH_ADDR=auth:50051
GRPC_ROLE_ADDR=role:50052
GRPC_CARD_ADDR=card:50053
GRPC_MERCHANT_ADDR=merchant:50054
GRPC_USER_ADDR=user:50055
GRPC_SALDO_ADDR=saldo:50056
GRPC_TOPUP_ADDR=topup:50057
GRPC_TRANSACTION_ADDR=transaction:50058
GRPC_TRANSFER_ADDR=transfer:50059
GRPC_WITHDRAW_ADDR=withdraw:50060

GRPC_AUTH_PORT=50051
GRPC_ROLE_PORT=50052
GRPC_CARD_PORT=50053
GRPC_MERCHANT_PORT=50054
GRPC_USER_PORT=50055
GRPC_SALDO_PORT=50056
GRPC_TOPUP_PORT=50057
GRPC_TRANSACTION_PORT=50058
GRPC_TRANSFER_PORT=50059
GRPC_WITHDRAW_PORT=50060

# ai-security client (Python gRPC server on 50051)
GRPC_CLIENT_AI_SECURITY_HOST=ai-security
GRPC_CLIENT_AI_SECURITY_PORT=50051
AI_SECURITY_HOST=ai-security
AI_SECURITY_PORT=50051

SMTP_SERVER=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=giovani.roberts@ethereal.email
SMTP_PASS=hwwvTzhWP2wW1y733m
